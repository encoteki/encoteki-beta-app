# App Environment
NEXT_PUBLIC_APP_ENV=

# Xellar
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_XELLAR_APP_ID=

# TSB Contracts (one per chain — see src/constants/contracts/tsb.ts)
NEXT_PUBLIC_TSB_BASE_CONTRACT=
NEXT_PUBLIC_TSB_ARBITRUM_CONTRACT=
NEXT_PUBLIC_TSB_LISK_CONTRACT=
NEXT_PUBLIC_TSB_MANTA_CONTRACT=
NEXT_PUBLIC_TSB_ETHEREUM_CONTRACT=
NEXT_PUBLIC_TSB_ROBINHOOD_CONTRACT=
NEXT_PUBLIC_TSB_MONAD_CONTRACT=

# Payment Token Addresses (per chain — native/USDC/USDT/IDRX as applicable)
NEXT_PUBLIC_BASE_USDC_ADDRESS=
NEXT_PUBLIC_BASE_IDRX_ADDRESS=

NEXT_PUBLIC_ARBITRUM_NATIVE_ADDRESS=
NEXT_PUBLIC_ARBITRUM_USDC_ADDRESS=
NEXT_PUBLIC_ARBITRUM_USDT_ADDRESS=

NEXT_PUBLIC_LISK_NATIVE_ADDRESS=
NEXT_PUBLIC_LISK_USDT_ADDRESS=
NEXT_PUBLIC_LISK_IDRX_ADDRESS=

NEXT_PUBLIC_MANTA_NATIVE_ADDRESS=
NEXT_PUBLIC_MANTA_USDC_ADDRESS=
NEXT_PUBLIC_MANTA_USDT_ADDRESS=

NEXT_PUBLIC_ROBINHOOD_USDG_ADDRESS=

# Mint prices per token (optional — each falls back to a hardcoded default in
# src/constants/contracts/tsb.ts when unset).
NEXT_PUBLIC_MINT_PRICE_ETH=
NEXT_PUBLIC_MINT_PRICE_LSK=
NEXT_PUBLIC_MINT_PRICE_ARB=
NEXT_PUBLIC_MINT_PRICE_MANTA=
NEXT_PUBLIC_MINT_PRICE_USDC=
NEXT_PUBLIC_MINT_PRICE_USDT=
NEXT_PUBLIC_MINT_PRICE_IDRX=
NEXT_PUBLIC_MINT_PRICE_MON=
NEXT_PUBLIC_MINT_PRICE_USDG=

# LayerZero Scan API (cross-chain mint delivery status polling).
# Optional — defaults to LayerZero's public scan API when unset.
NEXT_PUBLIC_LZ_API_URL=

# Encoteki API
# Base URL for the Encoteki backend (auth, register, referral, leaderboard,
# proposals). Gated routes authenticate via session cookie — no API key.
# Optional — defaults to https://api.encoteki.com when unset.
NEXT_PUBLIC_API_URL=

# SIWE
# Pin the public app URL so the SIWE domain the client signs always matches
# what the backend's SIWE_DOMAIN expects, regardless of reverse-proxy header
# forwarding. Auth itself (nonce/verify/session) is handled by the backend —
# this app only builds and signs the SIWE message.
NEXT_PUBLIC_APP_URL=

# IPFS gateway host for NFT metadata/imagery (optional; defaults to ipfs.io).
# Host only, no protocol — e.g. my-gateway.mypinata.cloud
NEXT_PUBLIC_GATEWAY_URL=

# Observability (Sentry) — leave unset to fully disable error tracking.
# Same DSN value works for both; NEXT_PUBLIC_ is needed for the browser SDK.
NEXT_PUBLIC_SENTRY_DSN=https://947b8b3fd032af424c4cb26554df4566@o4511568593158144.ingest.us.sentry.io/4511568594534400
SENTRY_DSN=https://947b8b3fd032af424c4cb26554df4566@o4511568593158144.ingest.us.sentry.io/4511568594534400
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
# Source-map upload (so prod stack traces de-minify). Optional — without these
# the build still works, it just skips uploading maps. Token scopes: project:releases, org:read.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Content-Security-Policy enforcement. Defaults to report-only (safe). Set to
# "true" to enforce the full policy — only after verifying the login/mint flow
# in-browser with no CSP violations in the console.
CSP_ENFORCE=
